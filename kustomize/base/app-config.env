# Non-sensitive settings. configMapGenerator turns each line into a ConfigMap key.
# Backend (application naming)
DB_HOST=db-svc
DB_PORT=5432
DB_NAME=tasktracker
APP_PORT=8080
CORS_ORIGIN=*
# Database (official postgres image naming). Must equal DB_NAME.
POSTGRES_DB=tasktracker
# Frontend
BACKEND_URL=http://backend-svc:8080
